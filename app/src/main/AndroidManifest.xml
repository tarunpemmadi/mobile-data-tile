<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permission to read network usage stats (user grants via Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Permission to read subscriber ID (optional, for better data attribution) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Re-boot receiver so the tile refreshes after device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.MobileDataTile"
        android:supportsRtl="true">

        <!-- Quick Settings tile service -->
        <service
            android:name=".DataTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_data_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Main settings activity (launcher) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fired by the daily alarm to refresh the tile -->
        <receiver
            android:name=".TileRefreshReceiver"
            android:exported="false" />

        <!-- Boot receiver to re-schedule tile refresh -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
